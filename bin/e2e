#!/usr/bin/env bash
# Parties complètes dans Chrome headless (Playwright, Chrome système). Il faut Internet :
# la partie en réseau passe par le serveur public de PeerJS.
# BELOTE_SHOTS=dossier pour garder des captures d'écran.
set -euo pipefail
cd "$(dirname "$0")/.."
exec .venv/bin/python -m pytest -q -p no:cacheprovider tests/test_e2e.py "$@"
