#!/usr/bin/env bash
# Lance le serveur en développement (rechargement automatique).
# Usage : bin/dev [port]
set -euo pipefail
cd "$(dirname "$0")/.."
PORT="${1:-${BELOTE_PORT:-8010}}"
exec .venv/bin/uvicorn belote.app:app --app-dir backend --host 0.0.0.0 --port "$PORT" --reload --reload-dir backend
